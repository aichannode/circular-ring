		"react-native-date-picker": "^4.1.1",
		"react-native-device-info": "^8.3.3",
		"react-native-dialog": "^9.2.0",
		"react-native-draggable-flatlist": "^2.6.2",
		"react-native-drax": "^0.9.1",
		"react-native-fs": "^2.18.0",
		"react-native-gesture-handler": "^1.10.3",
