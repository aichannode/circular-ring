{
	"name": "Circular",
	"version": "0.0.3",
	"private": true,
	"scripts": {
		"finish-release": "standard-version && git-flow release finish -n",
		"upgrade-wording": "sync-wording --upgrade && node ./scripts/flattenWording.js",
		"android": "ENVFILE=.env.dev react-native run-android --variant='DevDebug' --appIdSuffix=dev",
		"ios": "react-native run-ios --scheme 'Circular-Dev'",
		"start": "react-native start",
		"test": "jest",
		"lint": "eslint . --fix",
		"tsc": "tsc -noEmit",
		"pods": "cd ios && bundle exec pod install && cd .."
	},
	"engines": {
		"node": "^12",
		"npm": "^6"
	},
	"dependencies": {
		"@betomorrow/logging-core": "^1.0.5",
