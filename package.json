		"amazon-cognito-identity-js": "^5.1.0",
		"axios": "^0.21.1",
		"buffer": "^6.0.3",
		"dayjs": "^1.10.7",
		"flat": "^5.0.2",
		"immer": "^9.0.7",
		"jsc-android": "^250230.2.1",
		"micro-observables": "^1.7.0",
		"micro-signals": "^2.4.0",
		"mobx": "^6.3.10",
		"mobx-react-lite": "^3.2.2",
		"node-emoji": "^1.11.0",
		"patch-package": "^6.4.7",
		"react": "17.0.2",
		"react-intl": "^5.20.10",
		"react-native": "0.65.1",
		"react-native-background-timer": "^2.4.1",
		"react-native-ble-manager": "^8.0.0",
		"react-native-ble-plx": "^2.0.2",
