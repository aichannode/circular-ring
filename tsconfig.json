{
	"compilerOptions": {
		"strict": true,
		"strictNullChecks": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"sourceMap": true,
		"noEmit": true,
		"target": "esnext",
		"lib": ["ES6"],
		"module": "CommonJS",
		"moduleResolution": "node",
		"jsx": "react-native",
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"allowJs": true,
		"paths": {
			"@assets/*": ["src/assets/*"],
			"@wordings": ["wordings"],
			"@core/*": ["src/core/*"],
			"@domain/*": ["src/domain/*"],
			"@ui/*": ["src/ui/*"],
			"@utils/*": ["src/utils/*"],
			"@adapters/*": ["src/adapters/*"],
			"@stories": ["storybook"],
		},
		"plugins": [
			{
				"name": "typescript-styled-plugin",
				"lint": {
					"validProperties": [
						"shadow-color",
						"shadow-opacity",
						"shadow-offset",
						"shadow-radius",
						"padding-horizontal",
						"padding-vertical",
						"margin-vertical",
						"margin-horizontal",
						"tint-color",
						"aspect-ratio",
						"elevation",
						"resize-mode"
					]
				}
			}
		]
	},
	"include": [
		"src/**/*",
		"storybook/**/*",
		"__mocks__/**/*.js",
		"global.d.ts",
		"./*.js",
		"scripts/**/*.js",
		"./.eslintrc.js"
	]
}
